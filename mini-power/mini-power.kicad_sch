	(label "-2V75_A" (at 454.66 129.54 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0b62ef5f-a8de-4074-9372-84d6659ce315"))
	(text "Block E-B: -2.75 V inverter, option B (P-FET + inductor, regulated by the controller in burst mode)" (exclude_from_sim no) (at 391.16 173.99 0) (effects (font (size 2.0 2.0) bold) (justify left top)) (uuid "13fc6db7-6c03-4a74-8b49-6f58f69bdbcd"))
	(text "B_DRV gates Q1 (low = on). While Q1 is on, L6 charges from +2.75 V; when it turns off the stored energy flows through D4 into the negative rail." (exclude_from_sim no) (at 391.16 179.07 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2a89bdc4-6880-4449-8425-e70a77bcc51e"))
	(text "U4 (LPV521, 0.35 uA) inverts the rail into SENSE = 0.499 x |VRAIL| (1.37 V at -2.75 V); the controller skips pulses once SENSE reaches the target." (exclude_from_sim no) (at 391.16 182.88 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0b24cb41-a54d-403b-b600-4e6f8448ab22"))
